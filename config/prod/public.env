# Public (non-secret) configuration for the "prod" deployment.
# Source of truth for the assembled .env — edit here, then `dotconfig load prod`.

# Where scraped partner websites are cached (raw HTML + response metadata):
# a DigitalOcean Spaces bucket prefix, so the corpus never lands in git or
# the working tree.
SCRAPE_CACHE_DIR=s3://jtl-stem-ecosystem-scrape/cache

# S3-compatible (DigitalOcean Spaces) region endpoint -- NOT bucket-qualified.
DO_SPACES_ENDPOINT=https://sfo3.digitaloceanspaces.com

# Where the pipeline writes its own data (partners, events, images, logs).
PARTNER_SCRAPE_DATA_DIR=s3://jtl-stem-ecosystem-scrape/data
