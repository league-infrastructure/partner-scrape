---
// Clones TeamFilters.astro's build-time facet-count pattern, adapted from
// league/org_type to category -- the grouping facet issue 35 and ticket
// 018-009's own description ask for ("group or filter by category").
// Kept to a single facet group (Category) plus search: with only 19 places
// across 6 categories, a second facet (e.g. status) would mostly show
// "18 open / 1 opening" -- not worth a second filter-group for this
// dataset's size (ticket's own "don't over-build a 19-item dataset" note).
//
// CATEGORIES is hand-listed (not derived from the data present), matching
// TeamFilters.astro's own hardcoded `leagues`/`orgTypes` lists -- unlike
// Club's open-ended `club_type` (see ClubFilters/model.py's own docstring
// for why that one must never be hardcoded), Place.category is a closed,
// six-value Literal this dataset already covers in full (directory/model.py's
// `Category`), so listing all six here is the same "closed set, hand-listed"
// precedent as `leagues`, not an assumption about what's present.
import placesData from '../data/places.json';

const places = placesData.places as any[];

function tally(field: string): Map<string, number> {
  const map = new Map<string, number>();
  for (const place of places) {
    const v = place[field];
    if (v == null || v === '') continue;
    map.set(v, (map.get(v) ?? 0) + 1);
  }
  return map;
}

const categoryCounts = tally('category');

const categories = [
  { value: 'makerspace', label: 'Makerspace' },
  { value: 'planetarium', label: 'Planetarium' },
  { value: 'observatory', label: 'Observatory' },
  { value: 'tide-pool', label: 'Tide Pool' },
  { value: 'nature-center', label: 'Nature Center' },
  { value: 'library-maker-lab', label: 'Library Maker Lab' },
];
---

<aside class="filter-sidebar collapsed" id="place-filters">
  <button class="btn filter-toggle" id="filter-toggle-btn">Filter Places</button>

  <div class="filter-group">
    <div class="filter-group-title">Search</div>
    <input type="text" class="filter-search" placeholder="Search name or description…" data-filter="search" />
  </div>

  <div class="filter-group">
    <div class="filter-group-title">Category</div>
    {categories.map(opt => {
      const c = categoryCounts.get(opt.value) ?? 0;
      return (
        <label class:list={['filter-option', { 'is-empty': c === 0 }]}>
          <input type="checkbox" data-filter="type" value={opt.value} disabled={c === 0} />
          <span class="facet-name">{opt.label}</span>
          <span class="facet-count">({c})</span>
        </label>
      );
    })}
    <a href="#" class="filter-clear-section" data-clear-section>Clear</a>
  </div>

  <div class="filter-actions">
    <a href="#" class="filter-clear-all" id="clear-filters" data-clear-all>Clear all filters</a>
  </div>
</aside>
