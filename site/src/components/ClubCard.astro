---
// Modeled directly on TeamCard.astro's/PlaceCard.astro's shape (title
// anchor nested inside <h3>, top row tag + top-right icon, meta row,
// bottom "View" link) -- the same precedent ticket 018-009 was told to
// follow. club_type drives the top tag the way league/category does for
// Team/Place; CLUB_TYPE_LABELS is intentionally not exhaustive of every
// type issue 35b may eventually add (directory/model.py's own docstring:
// "kept general enough that issue 35b's future club types fit without a
// model change") -- an unrecognized type falls back to the raw value
// rather than being mislabeled or hidden.
import SocialIcon from './SocialIcon.astro';

interface Props {
  club: {
    club_id: string;
    name: string;
    club_type: string;
    host_school: string;
    city: string;
    postal_code: string;
    latitude: number | null;
    longitude: number | null;
    location_precision: string;
    matched_name: string;
    needs_review: boolean;
    website: string;
    host_school_website: string;
    meeting_note: string;
    status: string;
    status_note: string;
  };
}

const { club } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/+$/, ''); // "" or "/partner-scrape"

const CLUB_TYPE_LABELS: Record<string, string> = {
  'hack-club': 'Hack Club',
};
const clubTypeLabel = CLUB_TYPE_LABELS[club.club_type] ?? club.club_type;

// Chapter's own site if curated, else the host school's -- never both
// links shown as if they were the same thing (matches Club.website vs.
// Club.host_school_website's own docstring distinction).
const linkUrl = club.website || club.host_school_website;
const isActive = club.status === 'active';
---

<article
  class="club-card card"
  data-type={club.club_type}
  data-status={club.status}
  data-title={`${club.name} ${club.host_school}`.toLowerCase()}
  data-desc={`${club.host_school} ${club.city}`.toLowerCase()}
  data-lat={club.latitude}
  data-lng={club.longitude}
  data-precision={club.location_precision}
  data-city={club.city}
>
  <div class="club-card-top">
    <span class="tag tag-purple">{clubTypeLabel}</span>
    <div class="club-card-top-right">
      {linkUrl && <SocialIcon platform="website" url={linkUrl} size={18} />}
      {!isActive && <span class="tag tag-pink">Inactive</span>}
    </div>
  </div>
  <h3><a href={`${base}/clubs/${club.club_id}`}>{club.name}</a></h3>
  <p class="club-card-school">{club.host_school}</p>
  <div class="club-card-meta">
    <span class="club-card-city">{club.city || 'Location unknown'}</span>
  </div>
  <a href={`${base}/clubs/${club.club_id}`} class="club-card-link">View Club →</a>
</article>

<style>
  .club-card {
    text-align: left;
    display: flex;
    flex-direction: column;
    padding: 24px;
  }

  .club-card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    margin-bottom: 12px;
  }

  .club-card-top-right {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .club-card h3 {
    font-size: 18px;
    margin-bottom: 4px;
    line-height: 1.3;
  }
  .club-card h3 a {
    color: var(--text-dark);
  }
  .club-card h3 a:hover {
    color: var(--purple);
  }

  .club-card-school {
    font-size: 13px;
    color: var(--text);
    margin-bottom: 10px;
    flex-grow: 1;
  }

  .club-card-meta {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 13px;
    color: var(--text);
    margin-bottom: 12px;
  }

  .club-card-link {
    font-size: 14px;
    font-weight: 700;
    color: var(--purple);
  }
  .club-card-link:hover {
    color: var(--pink);
  }

  .club-card[data-hidden] {
    display: none;
  }
</style>
