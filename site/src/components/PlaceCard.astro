---
// Modeled directly on TeamCard.astro's shape (title anchor nested inside
// <h3>, top row tags + top-right icon, card meta row, bottom "View" link) --
// the same precedent ticket 018-009 was told to follow. Place has no
// program/league facet the way Team does; category fills that role.
import SocialIcon from './SocialIcon.astro';

interface Props {
  place: {
    place_id: string;
    name: string;
    category: string;
    description: string;
    address: string;
    city: string;
    postal_code: string;
    latitude: number | null;
    longitude: number | null;
    location_precision: string;
    matched_name: string;
    needs_review: boolean;
    website: string;
    status: string;
    status_note: string;
    related_partner_id: number | null;
  };
}

const { place } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/+$/, ''); // "" or "/partner-scrape"

const CATEGORY_LABELS: Record<string, string> = {
  makerspace: 'Makerspace',
  planetarium: 'Planetarium',
  observatory: 'Observatory',
  'tide-pool': 'Tide Pool',
  'nature-center': 'Nature Center',
  'library-maker-lab': 'Library Maker Lab',
};
const categoryLabel = CATEGORY_LABELS[place.category] ?? place.category;

// Only a place actually carrying a website is worth surfacing, matching
// TeamCard's "never advertise a link we don't have" gating (Place has no
// website_status field to further gate on -- a curated, hand-entered value
// is trusted the way Team's `confirmed` fetch result is).
const hasWebsite = !!place.website;
const isOpen = place.status === 'open';
---

<article
  class="place-card card"
  data-type={place.category}
  data-status={place.status}
  data-title={place.name.toLowerCase()}
  data-desc={`${place.description} ${place.city}`.toLowerCase()}
  data-lat={place.latitude}
  data-lng={place.longitude}
  data-precision={place.location_precision}
  data-city={place.city}
>
  <div class="place-card-top">
    <span class="tag tag-purple">{categoryLabel}</span>
    <div class="place-card-top-right">
      {hasWebsite && <SocialIcon platform="website" url={place.website} size={18} />}
      {!isOpen && <span class="tag tag-pink">{place.status === 'opening' ? 'Opening Soon' : 'Closed'}</span>}
    </div>
  </div>
  <h3><a href={`${base}/places/${place.place_id}`}>{place.name}</a></h3>
  <p class="place-card-desc">{place.description}</p>
  <div class="place-card-meta">
    <span class="place-card-city">{place.city || 'Location unknown'}</span>
  </div>
  <a href={`${base}/places/${place.place_id}`} class="place-card-link">View Place →</a>
</article>

<style>
  .place-card {
    text-align: left;
    display: flex;
    flex-direction: column;
    padding: 24px;
  }

  .place-card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    margin-bottom: 12px;
  }

  .place-card-top-right {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .place-card h3 {
    font-size: 18px;
    margin-bottom: 4px;
    line-height: 1.3;
  }
  .place-card h3 a {
    color: var(--text-dark);
  }
  .place-card h3 a:hover {
    color: var(--purple);
  }

  .place-card-desc {
    font-size: 13px;
    color: var(--text);
    margin-bottom: 10px;
    flex-grow: 1;
  }

  .place-card-meta {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 13px;
    color: var(--text);
    margin-bottom: 12px;
  }

  .place-card-link {
    font-size: 14px;
    font-weight: 700;
    color: var(--purple);
  }
  .place-card-link:hover {
    color: var(--pink);
  }

  .place-card[data-hidden] {
    display: none;
  }
</style>
