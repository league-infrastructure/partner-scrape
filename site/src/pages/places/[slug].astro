---
// getStaticPaths() over places.json; reuses the existing .detail-page +
// mini-map pattern from teams/[slug].astro (the direct precedent ticket
// 018-009 was told to follow). The slug is Place.place_id itself, which
// already doubles as this Place's stable URL slug (directory/model.py's
// own docstring: "one field doubles as both id and slug", mirroring
// Team.team_id's identical convention).
import BaseLayout from '../../layouts/BaseLayout.astro';
import placesData from '../../data/places.json';

export function getStaticPaths() {
  return (placesData.places as any[]).map(place => ({
    params: { slug: place.place_id },
    props: { place },
  }));
}

const { place } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/+$/, ''); // "" or "/partner-scrape"

const CATEGORY_LABELS: Record<string, string> = {
  makerspace: 'Makerspace',
  planetarium: 'Planetarium',
  observatory: 'Observatory',
  'tide-pool': 'Tide Pool',
  'nature-center': 'Nature Center',
  'library-maker-lab': 'Library Maker Lab',
};
const categoryLabel = CATEGORY_LABELS[place.category] ?? place.category;

const displayUrl = (url: string) => url.replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, '');

// A real, mappable coordinate: "none" precision places carry no
// latitude/longitude at all (directory/model.py's LocationPrecision --
// never a guessed point).
const hasLocation = place.latitude != null && place.longitude != null;

const PRECISION_LABELS: Record<string, string> = {
  address: 'Exact address',
  zip: 'Approximate (ZIP code center)',
  city: 'Approximate (city center)',
};
const precisionLabel = PRECISION_LABELS[place.location_precision] ?? '';

const isOpen = place.status === 'open';
---

<BaseLayout
  title={`${place.name} | SD STEM Ecosystem`}
  description={place.description || `${categoryLabel} in ${place.city || 'San Diego County'}.`}
>
  <div class="detail-page">
    <a href={`${base}/places`} class="back-link">← Back to Places</a>

    <div class="detail-header">
      <div class="place-detail-tags">
        <span class="tag tag-purple">{categoryLabel}</span>
        {!isOpen && (
          <span class="tag tag-pink">{place.status === 'opening' ? 'Opening Soon' : 'Closed'}</span>
        )}
        {place.needs_review && <span class="tag tag-pink">Location Needs Review</span>}
      </div>
      <h1>{place.name}</h1>
      {place.city && <p class="place-detail-city">{place.city}</p>}
    </div>

    <div class="detail-body">
      <div class="detail-content">
        <p>{place.description}</p>

        {!isOpen && place.status_note && (
          <div class="mt-3">
            <h3>Status</h3>
            <p>{place.status_note}</p>
          </div>
        )}
      </div>

      <aside class="detail-sidebar">
        <dl>
          <dt>Category</dt>
          <dd>{categoryLabel}</dd>

          {place.address && (
            <>
              <dt>Address</dt>
              <dd>{place.address}</dd>
            </>
          )}

          {!place.address && place.city && (
            <>
              <dt>City</dt>
              <dd>{place.city}</dd>
            </>
          )}

          {place.website && (
            <>
              <dt>Website</dt>
              <dd><a href={place.website} target="_blank" rel="noopener">{displayUrl(place.website)}</a></dd>
            </>
          )}
        </dl>

        {hasLocation && (
          <>
            <div class="detail-mini-map" id="detail-map" data-lat={place.latitude} data-lng={place.longitude}></div>
            {precisionLabel && <p class="place-precision-note">{precisionLabel}</p>}
          </>
        )}
      </aside>
    </div>
  </div>
</BaseLayout>

<script>
  const mapEl = document.getElementById('detail-map');
  if (mapEl) {
    const lat = parseFloat(mapEl.dataset.lat || '0');
    const lng = parseFloat(mapEl.dataset.lng || '0');
    if (!isNaN(lat) && !isNaN(lng) && lat !== 0) {
      const link = document.createElement('link');
      link.rel = 'stylesheet';
      link.href = 'https://unpkg.com/leaflet@1.9.4/dist/leaflet.css';
      document.head.appendChild(link);
      const script = document.createElement('script');
      script.src = 'https://unpkg.com/leaflet@1.9.4/dist/leaflet.js';
      script.onload = () => {
        // @ts-ignore
        const L = window.L;
        const map = L.map('detail-map').setView([lat, lng], 13);
        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
          attribution: '&copy; OpenStreetMap',
        }).addTo(map);
        L.marker([lat, lng]).addTo(map);
      };
      document.head.appendChild(script);
    }
  }
</script>

<style>
  .place-detail-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    margin-bottom: 12px;
  }

  .place-detail-city {
    font-size: 15px;
    color: var(--text);
    margin-top: 4px;
  }

  .detail-mini-map {
    height: 200px;
    border-radius: 6px;
    margin-top: 20px;
    overflow: hidden;
  }

  .place-precision-note {
    font-size: 12px;
    color: var(--text);
    opacity: 0.75;
    margin-top: 6px;
  }
</style>
