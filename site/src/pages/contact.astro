---
import BaseLayout from '../layouts/BaseLayout.astro';
import SocialIcon from '../components/SocialIcon.astro';
---

<BaseLayout title="Contact | SD STEM Ecosystem">
  <section class="hero hero-sm">
    <h1>Contact Us</h1>
  </section>

  <div class="contact-page container">
    <div class="contact-grid">
      <div class="contact-info">
        <h2>Get In Touch</h2>
        <p>Have questions about the SD STEM Ecosystem? Want to learn more about our programs or partner opportunities? We'd love to hear from you.</p>

        <div class="contact-details">
          <div class="contact-item">
            <h3>Address</h3>
            <p>1875 El Prado<br />San Diego, CA 92101</p>
          </div>
          <div class="contact-item">
            <h3>Phone</h3>
            <p><a href="tel:619-238-1233">(619) 238-1233</a></p>
          </div>
          <div class="contact-item">
            <h3>Social</h3>
            <div class="contact-social-icons">
              <SocialIcon platform="facebook" url="https://www.facebook.com/groups/1462184020556689/about/" size={24} />
              <SocialIcon platform="instagram" url="https://www.instagram.com/sdstemecosystem" size={24} />
              <SocialIcon platform="linkedin" url="https://www.linkedin.com/groups/7054524" size={24} />
            </div>
          </div>
        </div>
      </div>

      <div class="contact-cta card">
        <h2>Want to Add Your Organization?</h2>
        <p>If you're a STEM organization in San Diego County and would like to be listed in our partner directory or share your opportunities, we'd love to connect with you.</p>
        <form id="partner-form" class="partner-form mt-2">
          <label>
            Your Name
            <input type="text" name="name" required autocomplete="name" />
          </label>
          <label>
            Organization
            <input type="text" name="organization" autocomplete="organization" />
          </label>
          <label>
            Email
            <input type="email" name="email" required autocomplete="email" />
          </label>
          <label>
            Message
            <textarea name="message" rows="4" required></textarea>
          </label>
          <input type="text" name="_honey" class="honey" tabindex="-1" autocomplete="off" aria-hidden="true" />
          <button type="submit" class="btn btn-secondary">Send Message</button>
          <p class="form-status" role="status"></p>
        </form>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .hero-sm {
    min-height: auto;
    padding: 100px 20px 40px;
  }

  .contact-page {
    padding: 40px 15px 60px;
    max-width: 900px;
  }

  .contact-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 30px;
    align-items: start;
  }

  .contact-info h2 {
    margin-bottom: 12px;
  }

  .contact-info > p {
    line-height: 1.8;
    margin-bottom: 24px;
  }

  .contact-details {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .contact-item h3 {
    font-size: 14px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    margin-bottom: 4px;
    color: var(--purple);
  }

  .contact-social-icons {
    display: flex;
    gap: 14px;
    margin-top: 4px;
  }

  .contact-item p {
    line-height: 1.6;
  }

  .contact-cta {
    text-align: left;
    padding: 30px;
  }

  .contact-cta h2 {
    font-size: 24px;
    margin-bottom: 12px;
  }

  .contact-cta p {
    line-height: 1.7;
  }

  .partner-form {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .partner-form label {
    display: flex;
    flex-direction: column;
    gap: 4px;
    font-size: 14px;
    font-weight: 600;
  }

  .partner-form input,
  .partner-form textarea {
    font: inherit;
    font-weight: 400;
    padding: 8px 10px;
    border: 1px solid rgba(0, 0, 0, 0.2);
    border-radius: 4px;
  }

  .partner-form textarea {
    resize: vertical;
  }

  .partner-form .honey {
    display: none;
  }

  .partner-form button {
    align-self: flex-start;
  }

  .form-status {
    font-size: 14px;
    min-height: 1.4em;
    margin: 0;
  }

  @media (max-width: 767px) {
    .contact-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  const form = document.getElementById('partner-form') as HTMLFormElement;
  // Recipient assembled at runtime so the address never appears in the page source.
  const addr = ['eric', 'busboom'].join('.') + '@' + ['jointheleague', 'org'].join('.');

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const status = form.querySelector('.form-status') as HTMLElement;
    const button = form.querySelector('button') as HTMLButtonElement;
    button.disabled = true;
    status.textContent = 'Sending…';

    const data: Record<string, unknown> = Object.fromEntries(new FormData(form));
    data._subject = 'SD STEM Ecosystem partner inquiry';
    data._template = 'table';
    data._captcha = 'false';

    try {
      const res = await fetch('https://formsubmit.co/ajax/' + addr, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify(data),
      });
      if (!res.ok) throw new Error(String(res.status));
      form.reset();
      status.textContent = "Thanks — we've received your message and will be in touch.";
    } catch {
      status.textContent =
        'Something went wrong sending your message. Please try again, or call us at (619) 238-1233.';
    } finally {
      button.disabled = false;
    }
  });
</script>
