    margin-bottom: 20px;
    box-shadow: var(--shadow);
  }

  .code-block code {
    font-family: 'SFMono-Regular', Consolas, 'Liberation Mono', Menlo, monospace;
    font-size: 13px;
    line-height: 1.6;
    background: none;
